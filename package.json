{
    "name": "helikon-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "browserslist": [
        "last 2 versions",
        "> 1%",
        "not dead",
        "not ie 11"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:check": "eslint . --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@solidjs/router": "^0.16.1",
        "@solidjs/testing-library": "^0.8.10",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "browserslist": "^4.28.2",
        "browserslist-to-esbuild": "^2.1.1",
        "date-fns": "^4.3.0",
        "eslint": "^9.39.4",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-solid": "^0.14.5",
        "ky": "^2.0.2",
        "lightningcss": "^1.32.0",
        "lucide": "^1.16.0",
        "mitt": "^3.0.1",
        "nanostores": "^1.3.0",
        "prettier": "^3.8.3",
        "solid-js": "^1.9.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.14",
        "vitest": "^4.1.7",
        "vite-plugin-solid": "^2.11.12"
    },
    "overrides": {
        "js-yaml": ">=4.1.1"
    },
